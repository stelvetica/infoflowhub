# 复制为 .env 后填写或直接替换占位值
# 飞书配置示例
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# 打标签用 LLM（OpenAI 兼容端点）。base_url 不要带 /v1——代码自行拼 /v1/chat/completions
PRIMARY_LLM_BASE_URL=
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_MODEL=

# 备用 LLM：主模型 429/5xx/连接失败时自动降级；不需要就整组留空
BACKUP_LLM_BASE_URL=
BACKUP_LLM_API_KEY=
BACKUP_LLM_MODEL=
